# Copy this file to .env and fill it in. Never commit .env.
DISCORD_TOKEN=paste-your-bot-token-here
# Your test server's id. While set, commands appear instantly in that server only.
# Remove it to register global commands.
GUILD_ID=
# Only for the raw examples and HTTP interactions:
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
WEBHOOK_URL=

# Optional: switches on /ask (Claude API). Every call costs money, so keep the daily cap low.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-4-5-20251001
# AI_DAILY_LIMIT=20
